{
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": [
    "src/data-access-layer/backstage/**",
    "src/data-access-layer/portfolio/**",
    "src/data-access-layer/auth/**",
    "src/components/navigation/CurrentUser.tsx",
    "src/components/wrappers/GenericTable.tsx",
    "src/components/creature-egg/**",
    "src/components/pagination/**",
    "src/components/search/**",
    "src/hooks/creature/**",
    "src/hooks/use-webmcp-landing-tools.ts",
    "src/middleware/backstage-viewer.server.ts",
    "src/routes/-components/landing/**",
    "src/services/**",
    "src/data/**",
    "src/types/backstage.ts",
    "src/types/portfolio-search.ts",
    "src/utils/lesson-seo.ts",
    "src/utils/paginate-items.ts",
    "src/config/info.ts",
    "src/config/site.ts"
  ],
  "compilerOptions": {
    "target": "ES2022",
    "jsx": "react-jsx",
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,

    /* Linting */
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedSideEffectImports": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
