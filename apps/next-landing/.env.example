# SQLite file for local Payload (admin / future blog). Landing page does not require Payload to render.
DATABASE_URL=file:./payload.db
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional: live GitHub repos (falls back to static fixtures when unset / failing)
# GITHUB_TOKEN=
PORTFOLIO_USE_STATIC_FIXTURES=1

# Optional contact → Telegram (server action logs when unset)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
