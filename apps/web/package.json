{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js + Payload experiment for the portfolio landing page (Lighthouse comparison vs TanStack)",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev --port 3055",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev --port 3055",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start --port 3055 --hostname 127.0.0.1",
    "start:e2e": "cross-env NODE_OPTIONS=--no-deprecation next start --port 4055 --hostname 127.0.0.1",
    "preview": "npm run start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "check-types": "tsc --noEmit",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation CI=1 payload run ./src/seed/seed-all.ts",
    "sync:repositories": "cross-env NODE_OPTIONS=--no-deprecation payload run ./src/seed/sync-repositories.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "@repo/github": "workspace:*",
    "@repo/site-constants": "workspace:*",
    "@repo/telegram": "workspace:*",
    "@tailwindcss/postcss": "^4.1.18",
    "animejs": "^4.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "10.1.0",
    "daisyui": "^5.5.23",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lucide-react": "^0.561.0",
    "next": "16.2.7",
    "payload": "3.86.0",
    "prism-react-renderer": "^2.4.1",
    "radix-ui": "^1.6.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-hotkeys-hook": "^5.3.2",
    "react-icons": "^5.6.0",
    "server-only": "^0.0.1",
    "sharp": "0.34.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@libsql/client": "0.14.0",
    "@playwright/test": "^1.57.0",
    "@types/node": "^24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24.15.0"
  }
}
