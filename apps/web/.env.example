# Required — SQLite file locally, or Turso (`libsql://…`) in production.
DATABASE_URL=file:./payload.db

# Required for Turso only (leave empty for local `file:` SQLite).
DATABASE_AUTH_TOKEN=

# Required — Payload encryption / session secret.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional — public site origin (Payload serverURL, metadata, Dev.to canonical URLs).
# Falls back to VERCEL_URL on Vercel, else http://localhost:3055.
# Local: http://localhost:3055  |  Production: https://www.tigawanna.vip
NEXT_PUBLIC_SITE_URL=http://localhost:3055

# Optional — Dev.to. Username for Blogs list “Import from Dev.to” (default: tigawanna).
# Key required for per-post Open/Sync: https://dev.to/settings/extensions
DEVTO_USERNAME=
DEV_TO_KEY=

# Optional — Smart draft from notes on Blogs list (OpenRouter).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional — admin "Pull from GitHub" on Repositories + cron / Payload Jobs sync.
GH_PAT=

# Optional — Vercel Cron / manual bearer for:
#   - POST/GET /api/cron/sync-repositories (queues listAndUpsertRepos)
#   - GET /api/payload-jobs/run?queue=github-enrich&limit=1
# Vercel injects Authorization: Bearer $CRON_SECRET automatically for cron jobs.
CRON_SECRET=

# Optional — force static portfolio fixtures (e2e / offline). Set to 0 or remove for live/CMS data.
PORTFOLIO_USE_STATIC_FIXTURES=1

# Optional — contact form + Payload email adapter → Telegram (inbox persists even when unset).
# When set, Payload `sendEmail` (forgot password, etc.) is relayed here instead of SMTP.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
