# SQLite / Turso for Payload (Drizzle + libSQL under `@payloadcms/db-sqlite`).
# Local file for offline work:
DATABASE_URL=file:./payload.db
# Remote Turso (serverless / Vercel):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site origin — Payload `serverURL`, metadata, Dev.to canonical URLs (`/blogs/{slug}`).
# Resolution (see `src/lib/site-url.ts`): NEXT_PUBLIC_SITE_URL → VERCEL_URL → http://localhost:3055.
# On Vercel, VERCEL_URL is set automatically; set NEXT_PUBLIC_SITE_URL for a custom domain.
# Local: http://localhost:3055  |  Production: https://www.tigawanna.vip
# NEXT_PUBLIC_SITE_URL=http://localhost:3055

# Dev.to open/sync from Payload admin + optional import (`pnpm import:devto`)
# DEVTO_USERNAME=tigawanna
# DEV_TO_KEY= # https://dev.to/settings/extensions

# OpenRouter — Smart draft from notes on Blogs list (Payload admin)
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# Optional: live GitHub repos (falls back to static fixtures when unset / failing)
# GITHUB_TOKEN=
PORTFOLIO_USE_STATIC_FIXTURES=1

# Contact form + Payload email adapter → Telegram (inbox persists even when unset).
# When set, Payload `sendEmail` (forgot password, etc.) is relayed here instead of SMTP.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# Legacy alias still accepted: TELEGRAM_CHAT_ID=
