# SQLite / Turso for Payload (Drizzle + libSQL under `@payloadcms/db-sqlite`).
# Local file for offline work:
DATABASE_URL=file:./payload.db
# Remote Turso (serverless / Vercel):
# DATABASE_URL=libsql://your-db-name.turso.io
# DATABASE_AUTH_TOKEN=

PAYLOAD_SECRET=change-me-to-a-long-random-string

# Public site origin — used later for Dev.to canonical URLs
# NEXT_PUBLIC_SITE_URL=http://localhost:3055

# Optional Dev.to import (`pnpm import:devto`)
# DEVTO_USERNAME=tigawanna
# DEVTO_API_KEY=

# Optional: live GitHub repos (falls back to static fixtures when unset / failing)
# GITHUB_TOKEN=
PORTFOLIO_USE_STATIC_FIXTURES=1

# Contact form → Telegram + Payload inbox (persists even when unset)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHANNEL_ID=
# Legacy alias still accepted: TELEGRAM_CHAT_ID=
